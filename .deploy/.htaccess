# Generated by scripts/build.py. Permanent redirects for legacy and /src URLs.
<IfModule mod_alias.c>
RedirectMatch 301 ^/Impressum(?:\.html|/)?$ /legal/imprint/
RedirectMatch 301 ^/Privacy(?:\.html|/)?$ /legal/privacy/
RedirectMatch 301 ^/Terms(?:\.html|/)?$ /legal/terms/
RedirectMatch 301 ^/legal/impressum(?:\.html|/)?$ /legal/imprint/
RedirectMatch 301 ^/blog(?:\.html|/)?$ https://medium.com/@sgroiga
RedirectMatch 301 ^/soft/menu\-launcher(?:\.html|/)?$ /apps/menu-launcher/
RedirectMatch 301 ^/soft/privacy\-menu\-launcher(?:\.html|/)?$ /legal/privacy/
RedirectMatch 301 ^/soft/terms\-menu\-launcher(?:\.html|/)?$ /legal/terms/
RedirectMatch 301 ^/soft/support\-menu\-launcher(?:\.html|/)?$ /Support/#menu-launcher
RedirectMatch 301 ^/soft/menu\-2fa(?:\.html|/)?$ /apps/menu-2fa/
RedirectMatch 301 ^/soft/privacy\-menu\-2fa(?:\.html|/)?$ /legal/privacy/
RedirectMatch 301 ^/soft/terms\-menu\-2fa(?:\.html|/)?$ /legal/terms/
RedirectMatch 301 ^/soft/support\-menu\-2fa(?:\.html|/)?$ /Support/#menu-2fa
RedirectMatch 301 ^/projects(/.*)?$ /apps$1
RedirectMatch 301 ^/src/(.*)$ /$1
</IfModule>
ErrorDocument 404 /error-page.html
